---
const { title, updated } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title} | Ekwly</title>
    <style is:global>
      .legal-content h2 {
        font-size: 1.5rem;
        font-weight: 800;
        margin-top: 2.5rem;
        margin-bottom: 1rem;
        color: var(--color-main, #ffffff);
        letter-spacing: -0.025em;
      }
      .legal-content h3 {
        font-size: 1.125rem;
        font-weight: 700;
        margin-top: 1.5rem;
        margin-bottom: 0.75rem;
        color: var(--color-main, #ffffff);
      }
      .legal-content p {
        font-size: 0.95rem;
        line-height: 1.6;
        color: var(--color-muted, #94a3b8);
        margin-bottom: 1.25rem;
      }
      .legal-content ul {
        list-style-type: disc;
        padding-left: 1.5rem;
        margin-bottom: 1.5rem;
        color: var(--color-muted, #94a3b8);
        font-size: 0.95rem;
      }
      .legal-content li {
        margin-bottom: 0.5rem;
      }
      .legal-content a {
        color: var(--color-primary, #3b82f6);
        text-decoration: none;
      }
      .legal-content a:hover {
        text-decoration: underline;
      }
      .legal-content strong {
        font-weight: 700;
        color: var(--color-main, #ffffff);
      }
    </style>
  </head>
  <body class="bg-page text-main min-h-screen antialiased selection:bg-primary/30">
    <div class="max-w-3xl mx-auto px-6 py-12 md:py-20 relative z-10">
      <a
        href="/ekwly/"
        class="inline-flex items-center gap-2 text-primary font-bold mb-10 hover:opacity-80 transition-opacity active:scale-95">
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round">
          <path d="m15 18-6-6 6-6" />
        </svg>
        Back to App
      </a>
      <h1 class="text-3xl md:text-5xl font-extrabold tracking-tight mb-4">{title}</h1>
      <p class="text-sm font-bold text-muted uppercase tracking-widest mb-12">
        Effective Date: {updated}
      </p>

      <div class="legal-content">
        <slot />
      </div>
    </div>
  </body>
</html>
