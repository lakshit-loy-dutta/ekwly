---
import '../styles/global.css';
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Account Deletion Request | Ekwly</title>
    <link rel="icon" href="/ekwly/favicon.ico" type="image/x-icon" />
  </head>
  <body class="bg-page text-main antialiased selection:bg-primary-light selection:text-primary min-h-screen py-10 px-4 md:px-8">
    <main class="max-w-3xl mx-auto bg-surface border border-border rounded-2xl p-6 md:p-10 shadow-sm">
      <div class="mb-6 pb-4 border-b border-border flex items-center justify-between">
        <a
          href="/ekwly/"
          class="text-sm font-semibold text-primary hover:text-primary-hover transition-colors">
          ← Return to App
        </a>
        <span class="text-xs font-bold text-danger uppercase tracking-widest">
          Account Management
        </span>
      </div>

      <h1 class="text-3xl font-bold tracking-tight text-main mb-2">Account & Data Deletion</h1>
      <p class="text-sm text-muted mb-8">
        Learn how to delete your Ekwly profile and all associated data, or trigger an immediate
        deletion request.
      </p>

      <section class="space-y-6 text-sm text-main/90 leading-relaxed">
        <div class="bg-primary/5 border border-primary/15 rounded-xl p-4">
          <h2 class="text-base font-bold text-primary mb-1">
            Option 1: In-App Immediate Deletion (Fastest)
          </h2>
          <p class="text-muted text-xs leading-relaxed mb-3">
            If you have the app open on web or mobile:
          </p>
          <ol class="list-decimal list-inside space-y-1 text-xs text-muted">
            <li>Open the app and select your avatar in the upper right.</li>
            <li>
              Click <strong class="text-main">Edit Profile</strong>.
            </li>
            <li>
              Scroll to the bottom and click{' '}
              <strong class="text-danger">Delete Account Permanently</strong>.
            </li>
            <li>
              Type <strong class="text-main">DELETE</strong> to confirm. Your profile and records
              are wiped instantly.
            </li>
          </ol>
        </div>

        <div>
          <h2 class="text-lg font-bold text-main mb-2">Option 2: Web Deletion Request</h2>
          <p class="text-muted mb-4">
            If you no longer have access to the app, submit your registered account details below.
            Our team validates identity and purges all server records within 7 calendar days.
          </p>

          <form
            action="https://formspree.io/f/placeholder"
            method="POST"
            class="bg-page border border-border rounded-xl p-4 md:p-6 space-y-4">
            <div>
              <label
                for="email"
                class="block text-xs font-bold uppercase tracking-wider text-muted mb-1">
                Registered Account Email
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                placeholder="name@example.com"
                class="w-full h-11 bg-surface border border-border rounded-lg px-3 text-main font-medium focus:outline-none focus:border-primary"
              />
            </div>

            <div>
              <label
                for="reason"
                class="block text-xs font-bold uppercase tracking-wider text-muted mb-1">
                Reason for Removal (Optional)
              </label>
              <textarea
                id="reason"
                name="reason"
                rows="3"
                placeholder="Provide any feedback or specifics..."
                class="w-full bg-surface border border-border rounded-lg p-3 text-main text-sm focus:outline-none focus:border-primary resize-none"></textarea>
            </div>

            <button
              type="submit"
              class="w-full h-11 bg-danger hover:bg-danger/90 active:scale-[0.99] text-white font-bold rounded-lg text-sm transition-all shadow-sm">
              Submit Deletion Request
            </button>
          </form>
        </div>

        <div>
          <h2 class="text-lg font-bold text-main mb-2">What Data Is Deleted?</h2>
          <ul class="list-disc list-inside space-y-1 text-muted">
            <li>
              <strong class="text-main">Permanently Purged:</strong> Name, authentication UID,
              email, linked UPI ID, connection friendships, personal ledger shares, and scan quota
              logs.
            </li>
            <li>
              <strong class="text-main">Anonymized Session Data:</strong> Bill breakdown items in
              active shared rooms where other group members remain active retain fallback text
              labels to prevent breaking peer calculations.
            </li>
            <li>
              <strong class="text-main">Retention Period:</strong> Database records cascade delete
              immediately. Server audit and security logs are fully wiped within 30 days.
            </li>
          </ul>
        </div>
      </section>
    </main>
  </body>
</html>
