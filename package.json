    "test": "vitest run",
    "build:mobile": "node -e \"require('child_process').execSync('pnpm astro build', {stdio:'inherit', env:{...process.env, CAPACITOR_BUILD:'true'}})\" && pnpm cap sync && node scripts/configure-native.mjs",
